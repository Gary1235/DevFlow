{
  "name": "devflow-desktop",
  "productName": "DevFlow",
  "version": "0.1.0",
  "description": "Local AI development workbench",
  "author": "DevFlow",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "prepare:backend": "node scripts/prepare.cjs",
    "start": "electron .",
    "dev": "npm run prepare:backend && electron .",
    "test": "node --test test/*.test.cjs",
    "smoke": "electron . --smoke-test",
    "smoke:packaged": "node scripts/smoke-packaged.cjs",
    "pack": "npm run prepare:backend && electron-builder --win --x64 --dir",
    "dist": "npm run prepare:backend && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.devflow.desktop",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [{ "from": "payload", "to": "backend" }],
    "win": { "target": "nsis", "icon": "src/icon.ico", "artifactName": "DevFlow-${version}-Setup.${ext}" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
